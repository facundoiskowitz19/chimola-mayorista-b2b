# Copiar a .env para correr local (gitignoreado). Los defaults apuntan a DEV.
APP_ENV=dev
GCP_PROJECT=chimola-deteccion
BQ_PROJECT=chimola-deteccion
FIRESTORE_PROJECT=chimola-deteccion
BUCKET_PEDIDOS=chimola-mayorista-pedidos-dev

# Fotos (viven en PROD, bucket público hoy; igual se firman URLs)
BUCKET_FOTOS=ecommerce-b2b-imagenes
FOTOS_PREFIX=catalogo/fotos_productos

# Email: secret del pipeline hermano (vive en chimola-490015)
SMTP_SECRET_PROJECT=chimola-490015
SMTP_SECRET_NAME=email-smtp-credentials
# A quién le llegan los pedidos en Chimola (definir con el equipo; ej: pedidos@lautin.com.ar)
PEDIDOS_EMAIL_TO=fiskowitz@lautin.com.ar
# DEV: redirigir TODOS los mails a esta casilla (vacío en PROD)
EMAIL_OVERRIDE_TO=fiskowitz@lautin.com.ar
EMAIL_ENABLED=true

# JWT: si no está, se lee Secret Manager `mayorista-jwt-key` del GCP_PROJECT
# JWT_KEY=cambiame-solo-para-local
JWT_TTL_HORAS=24
LOGIN_MAX_INTENTOS=5
LOGIN_VENTANA_MIN=15

MAX_BYTES_BILLED=1000000000
CATALOGO_TTL_SEG=1800
ITEMS_POR_PAGINA=24
